{
  "id": "guardedops/github-operations",
  "name": "GitHub Operations Airlock - governed issue triage and pull-request review",
  "version": "1.1.2",
  "description": "A 31-command, governance-first GitHub REST module for issue triage, pull-request review, Actions, releases, files, branches, protection, merges, and deployments. Public reads need no credential; private reads and every write resolve a fine-grained token only from RailCall's local vault. Every mutation is previewed, approval-gated, receipted, and attributable. Command examples: github.get_repository {\"owner\":\"octocat\",\"repo\":\"Hello-World\"}; github.list_issues {\"state\":\"open\"}; github.get_issue {\"issue_number\":12}; github.search_issues {\"query\":\"startup regression\"}; github.create_issue {\"title\":\"Document retries\"}; github.update_issue {\"issue_number\":12,\"state\":\"closed\"}; github.add_issue_comment {\"issue_number\":12,\"body\":\"Verified\"}; github.list_pull_requests {\"base\":\"main\"}; github.get_pull_request {\"pull_number\":42}; github.request_pull_request_reviewers {\"pull_number\":42,\"reviewers\":[\"octocat\"]}; github.list_workflow_runs {\"status\":\"failure\"}; github.dispatch_workflow {\"workflow_id\":\"ci.yml\",\"ref\":\"main\"}; github.cancel_workflow_run {\"run_id\":123}; github.list_workflow_run_artifacts {\"run_id\":123}; github.list_releases {\"limit\":20}; github.create_release {\"tag_name\":\"v1.1.0\",\"draft\":true}; github.update_release {\"release_id\":9,\"draft\":false}; github.delete_release {\"release_id\":9}; github.get_file {\"path\":\"README.md\"}; github.put_file {\"path\":\"docs/runbook.md\",\"message\":\"Add runbook\",\"content_base64\":\"SGVsbG8=\"}; github.delete_file {\"path\":\"docs/old.md\",\"message\":\"Remove\",\"sha\":\"0123456789abcdef0123456789abcdef01234567\"}; github.list_branches {\"protected\":true}; github.create_branch {\"branch\":\"release/v1.1\",\"sha\":\"0123456789abcdef0123456789abcdef01234567\"}; github.delete_branch {\"branch\":\"release/old\"}; github.get_branch_protection {\"branch\":\"main\"}; github.update_branch_protection {\"branch\":\"main\",\"protection\":{\"required_status_checks\":null,\"enforce_admins\":true,\"required_pull_request_reviews\":null,\"restrictions\":null}}; github.merge_pull_request {\"pull_number\":42,\"merge_method\":\"squash\"}; github.create_pull_request_review {\"pull_number\":42,\"event\":\"approve\"}; github.list_deployments {\"environment\":\"production\"}; github.create_deployment {\"ref\":\"main\",\"environment\":\"staging\"}; github.create_deployment_status {\"deployment_id\":88,\"state\":\"success\"}. Reads use bounded retries and allowlisted output. Writes are never retried after ambiguous transport failure. Destructive or policy-changing operations are high risk. contest:2026Q3",
  "provider": "github",
  "license_required": false,
  "homepage": "https://revenue-recovery-workflow-lab.mbawtry.chatgpt.site/railcall/github-operations",
  "tests_url": "https://revenue-recovery-workflow-lab.mbawtry.chatgpt.site/railcall/github-operations#validation",
  "video_url": "https://youtu.be/m5FqTpumXUE",
  "auth": {
    "type": "api_key",
    "vault_provider": "github",
    "secret_field": "GITHUB_TOKEN",
    "docs": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"
  },
